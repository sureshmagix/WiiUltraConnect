{
  "name": "wiiultraconnect",
  "productName": "WiiUltraConnect",
  "version": "0.3.0",
  "description": "Direct one-to-one remote desktop, fullscreen control, chat, clipboard and files without intermediary services",
  "author": "WiiUltraConnect Team <support@wiiultraconnect.local>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "node scripts/build-target.mjs --target mac --arch arm64 --dir",
    "dist": "node scripts/build-all-local.mjs",
    "dist:mac:silicon": "node scripts/build-target.mjs --target mac --arch arm64",
    "dist:mac:intel": "node scripts/build-target.mjs --target mac --arch x64",
    "dist:win": "node scripts/build-target.mjs --target win --arch x64",
    "dist:linux:x64": "node scripts/build-target.mjs --target linux --arch x64",
    "dist:linux:arm64": "node scripts/build-target.mjs --target linux --arch arm64",
    "dist:agent:linux:x64": "node scripts/build-target.mjs --target agent-linux --arch x64",
    "dist:agent:linux:arm64": "node scripts/build-target.mjs --target agent-linux --arch arm64",
    "verify:release": "node scripts/verify-release.mjs",
    "configure:update-endpoint": "node scripts/configure-update-endpoint.mjs",
    "release:metadata": "node scripts/generate-update-metadata.mjs",
    "release:materials": "node scripts/generate-release-materials.mjs"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  }
}
