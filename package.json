{
  "name": "wiiultraconnect-direct",
  "productName": "WiiUltraConnect Direct",
  "version": "0.2.0-serverless.1",
  "description": "Wii Ultra Connect Direct — serverless screen sharing, chat, files, and remote control",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "optionalDependencies": { "@nut-tree-fork/nut-js": "4.2.6" },
  "devDependencies": { "electron": "44.2.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.wiiultraconnect.direct",
    "productName": "WiiUltraConnect Direct",
    "directories": { "output": "release/serverless" },
    "files": ["electron/**/*", "src/**/*", "package.json"],
    "asarUnpack": ["node_modules/@nut-tree*/**/*", "**/*.node"],
    "win": { "target": ["nsis"] },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "extendInfo": { "NSScreenCaptureUsageDescription": "Share a display with the person you invite to WiiUltraConnect." }
    },
    "linux": { "target": ["AppImage"], "category": "Network" }
  }
}
